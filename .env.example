# Required: create the bot with @BotFather and enable Threaded Mode.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Required: comma-separated numeric Telegram user IDs.
ALLOWED_USERS=123456789

# Application state and secrets live here. The default is shown for reference.
# TELEGRAM_AGENT_BOT_DIR=~/.telegram-agent-bot

# Agent used as the default for new topics: codex or claude.
TELEGRAM_AGENT_BOT_AGENT_TYPE=codex
TELEGRAM_AGENT_BOT_CODEX_COMMAND=codex
TELEGRAM_AGENT_BOT_CLAUDE_COMMAND=claude

# Optional owner-only provider environment for Claude Code.
# TELEGRAM_AGENT_BOT_CLAUDE_ENV_FILE=~/.telegram-agent-bot/claude.env

# Model defaults. Leave model lists unset for automatic discovery.
# TELEGRAM_AGENT_BOT_CODEX_MODEL=gpt-5.4-mini
# TELEGRAM_AGENT_BOT_CLAUDE_MODEL=deepseek-v4-flash
# TELEGRAM_AGENT_BOT_CODEX_MODELS=auto
# TELEGRAM_AGENT_BOT_CLAUDE_MODELS=auto
TELEGRAM_AGENT_BOT_MODEL_DISCOVERY=true
# TELEGRAM_AGENT_BOT_CODEX_REASONING_EFFORT=medium
# TELEGRAM_AGENT_BOT_CLAUDE_REASONING_EFFORT=high

# Local tmux backend. Install a plugin before selecting another backend.
TELEGRAM_AGENT_BOT_BACKEND=local
# TELEGRAM_AGENT_BOT_BACKEND_PLUGINS=python.module

# A private socket keeps AgentBot sessions separate from unrelated tmux use.
TELEGRAM_AGENT_BOT_TMUX_SESSION_NAME=telegram-agent-bot
TELEGRAM_AGENT_BOT_TMUX_SOCKET_NAME=telegram-agent-bot
# TELEGRAM_AGENT_BOT_TMUX_SOCKET_PATH=~/.telegram-agent-bot/tmux/telegram-agent-bot

# Project browser and transcript roots.
TELEGRAM_AGENT_BOT_DEFAULT_PROJECTS_PATH=~/Projects
# TELEGRAM_AGENT_BOT_PROJECT_ROOTS=Local=~/Projects,Remote=/mnt/remote-projects
# TELEGRAM_AGENT_BOT_CODEX_PROJECTS_PATH=~/.codex
TELEGRAM_AGENT_BOT_SHOW_HIDDEN_DIRS=false
TELEGRAM_AGENT_BOT_SHOW_EXTERNAL_RESUME_SESSIONS=false

# Durable queue and bounded concurrency. These values suit a small host.
TELEGRAM_AGENT_BOT_MAX_CONCURRENT_UPDATES=4
TELEGRAM_AGENT_BOT_MAX_ACTIVE_TURNS=2
TELEGRAM_AGENT_BOT_AGENT_INPUT_QUEUE_MAX_SIZE=20
TELEGRAM_AGENT_BOT_AGENT_INPUT_QUEUE_MAX_WAIT_SECONDS=0
TELEGRAM_AGENT_BOT_TRANSCRIPT_CONFIRM_TIMEOUT_SECONDS=15
TELEGRAM_AGENT_BOT_AGENT_STARTUP_TIMEOUT_SECONDS=180
TELEGRAM_AGENT_BOT_IDLE_SESSION_TIMEOUT_SECONDS=1800

# Polling and long-running status behavior.
TELEGRAM_AGENT_BOT_MONITOR_POLL_INTERVAL=2.0
TELEGRAM_AGENT_BOT_STATUS_POLL_INTERVAL=1.0
# Edit one status message instead of periodically posting a new one.
TELEGRAM_AGENT_BOT_STATUS_REPOST_INTERVAL=0

# Telegram output. Private model reasoning is never forwarded.
TELEGRAM_AGENT_BOT_OUTPUT_MODE=clean
TELEGRAM_AGENT_BOT_SHOW_USER_MESSAGES=true
TELEGRAM_AGENT_BOT_SHOW_COMMENTARY_MESSAGES=false
TELEGRAM_AGENT_BOT_SHOW_TOOL_CALLS=true
TELEGRAM_AGENT_BOT_SHOW_BASH_TOOL_CALLS=true

# Optional account snapshots and usage-limit failover.
TELEGRAM_AGENT_BOT_ENABLE_ACCOUNT_ROTATION=false

# Private operator health alerts. Unchanged issues respect the cooldown.
TELEGRAM_AGENT_BOT_HEALTH_ALERTS_ENABLED=true
TELEGRAM_AGENT_BOT_HEALTH_NOTIFICATION_LANGUAGE=en
TELEGRAM_AGENT_BOT_HEALTH_CHECK_INTERVAL_SECONDS=60
TELEGRAM_AGENT_BOT_HEALTH_ALERT_COOLDOWN_SECONDS=86400
TELEGRAM_AGENT_BOT_HEALTH_RECOVERY_STABLE_SECONDS=1800
TELEGRAM_AGENT_BOT_HEALTH_MEMORY_AVAILABLE_MB=256
TELEGRAM_AGENT_BOT_HEALTH_SWAP_USED_PERCENT=75
TELEGRAM_AGENT_BOT_HEALTH_DISK_USED_PERCENT=85
TELEGRAM_AGENT_BOT_HEALTH_QUEUE_OLDEST_SECONDS=3600
TELEGRAM_AGENT_BOT_HEALTH_TRANSCRIPT_LAG_SECONDS=300

# Source and agent CLI updates are opt-in. Idle checks protect active work.
TELEGRAM_AGENT_BOT_AUTO_UPDATE=false
TELEGRAM_AGENT_BOT_UPDATE_REQUIRE_IDLE=true
TELEGRAM_AGENT_BOT_UPDATE_INTERVAL_SECONDS=86400
TELEGRAM_AGENT_BOT_UPDATE_BUSY_RETRY_SECONDS=300
TELEGRAM_AGENT_BOT_UPDATE_RUN_UV_SYNC=true
TELEGRAM_AGENT_BOT_CODEX_UPDATE_CHECK=false
TELEGRAM_AGENT_BOT_CODEX_AUTO_UPDATE=false
TELEGRAM_AGENT_BOT_CODEX_UPDATE_NPM=npm

# Hook trust bypass is unsafe unless the installed hook was reviewed.
TELEGRAM_AGENT_BOT_CODEX_BYPASS_HOOK_TRUST=false

# Voice transcription providers are tried in order.
AI_TRANSCRIPTION_PROVIDERS=openai

# OpenAI-compatible transcription.
# AI_TRANSCRIPTION_OPENAI_API_KEY=
# AI_TRANSCRIPTION_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_TRANSCRIPTION_OPENAI_MODEL=gpt-4o-transcribe

# Google Gemini transcription.
# AI_TRANSCRIPTION_GOOGLE_API_KEY=
# AI_TRANSCRIPTION_GOOGLE_MODEL=gemini-2.0-flash-lite

# Optional GitHub Actions runner-pool supervisor.
# TELEGRAM_AGENT_BOT_RUNNER_POOL_ROOTS=~/actions-runner-one,~/actions-runner-two
# TELEGRAM_AGENT_BOT_RUNNER_POOL_POLL_SECONDS=180
# TELEGRAM_AGENT_BOT_RUNNER_IDLE_TIMEOUT_SECONDS=600

# Optional VPS cleanup policy.
# TELEGRAM_AGENT_BOT_CLEANUP_MAX_USED_PERCENT=80
# TELEGRAM_AGENT_BOT_CLEANUP_MIN_FREE_GB=6
# TELEGRAM_AGENT_BOT_CLEANUP_RUNNER_ROOTS=~/actions-runner-one,~/actions-runner-two
# TELEGRAM_AGENT_BOT_CLEANUP_PROTECTED_PATHS=/srv/important-workspace
