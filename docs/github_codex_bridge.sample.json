{
  "bridge_mode": "targets",
  "dispatch_mode": "poll",
  "tmux_socket": null,
  "issue_limit": 50,
  "body_limit": 4000,
  "comment_limit": 3,
  "poll_interval_seconds": 300,
  "retry_attempts": 3,
  "retry_base_delay_seconds": 1.0,
  "targets": [
    {
      "name": "maintenance",
      "repo": "owner/repository",
      "window": "@12",
      "workspace": "/srv/work/repository",
      "labels": ["agent-task"],
      "query": "maintenance",
      "merge_mode": "manual",
      "merge_label": "auto-merge-ok",
      "extra_instructions": "Keep the change focused and open a draft PR."
    }
  ]
}
